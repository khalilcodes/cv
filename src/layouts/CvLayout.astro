---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import DynamicSvg from '../components/DynamicSvg.astro';
import { parseLink, getIcon } from '../lib/utils';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	/** Collection entry id, e.g. "index" or "software-engineer-frontend". */
	id: string;
	/** Overrides the <head> title. Defaults to SITE_TITLE. */
	title?: string;
	/** Overrides the meta description. Defaults to SITE_DESCRIPTION. */
	description?: string;
}

const { id, title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const entry = await getEntry("cv", id);

if (!entry) throw new Error(`cv data not found for id "${id}"`);

const { title: name, subTitle: role, socialLinks, contact, location } = entry.data;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="flex flex-col gap-4 max-w-3xl m-auto pt-20 sm:pt-26 px-8">
      <section class="flex flex-col sm:flex-row sm:items-center font-source-code text-sm gap-4 sm:gap-2">
        {socialLinks?.map((item: string) => (
          <>
            <div class="flex items-center gap-1">
              <DynamicSvg svgRaw={getIcon(item) as string} class="w-4 sm:w-5 h-auto" />
              <a href={parseLink(item)} target="_blank" class="underline">{item.replace("https://", "")}</a>
            </div>
            <span class="hidden sm:block last:hidden">|</span>
          </>
        ))}
      </section>
      <section class="flex items-center gap-2 font-source-code text-sm italic">
        <p>{contact}</p>
        <span>|</span>
        <p>{location}</p>
      </section>
      <section>
        <h1 class="font-medium text-2xl sm:text-3xl text-indigo-950 mt-2">{name.toUpperCase()}</h1>
        {role && <h2 class="font-source-code text-sm sm:text-md">{role}</h2>}
      </section>
			<section class="content flex flex-col gap-3">
        <Content />
      </section>
		</main>
		<Footer />
	</body>
</html>
